#!/usr/bin/env bash
set -euo pipefail

# Track 1: Daily critical-state backup on Proxmox host `haytham` (192.168.100.2).
# Dumps active DBs safely (Zone 1 Infisical pg_dumpall, Zone 2 Vaultwarden SQLite +
# Immich pg_dumpall, Zone 3/4 configs & Uptime Kuma SQLite) into an encrypted local
# restic repo. Off-host sync is pulled from Windows via scripts/pull-homelab-backups.bat
# (zero cloud, zero Samba, Windows-only SSH key).

STAGING="{{ backup_staging_dir }}"
REPO="{{ backup_restic_repo }}"
PASS_FILE="{{ backup_restic_password_file }}"

ct_running() {
  pct status "$1" 2>/dev/null | grep -q "status: running"
}

sqlite_hot_backup() {
  local ctid="$1"
  local src_db="$2"
  local dst_file="$3"
  pct exec "$ctid" -- python3 -c "
import os, sqlite3, sys
src_path = sys.argv[1]
if not os.path.exists(src_path):
    sys.exit(0)
tmp_path = '/tmp/online-backup.sqlite3'
if os.path.exists(tmp_path):
    os.remove(tmp_path)
src = sqlite3.connect(src_path)
dst = sqlite3.connect(tmp_path)
with dst:
    src.backup(dst)
dst.close()
src.close()
" "$src_db"
  if pct exec "$ctid" -- test -f /tmp/online-backup.sqlite3; then
    pct pull "$ctid" /tmp/online-backup.sqlite3 "$dst_file"
    pct exec "$ctid" -- rm -f /tmp/online-backup.sqlite3
  fi
}

rm -rf "${STAGING:?}"/*
mkdir -p "$STAGING"/{infisical,vaultwarden,immich,pihole,npm,homepage,uptime-kuma,proxmox}

echo "[backup] Proxmox LXC configs (/etc/pve/lxc)"
cp -a /etc/pve/lxc/*.conf "$STAGING/proxmox/" 2>/dev/null || true

if ct_running 110; then
  echo "[backup] CT 110 Infisical (Zone 1 P0: PostgreSQL dump + compose/env)"
  pct exec 110 -- docker exec infisical_postgres pg_dumpall --clean --if-exists --username=infisical | gzip -c > "$STAGING/infisical/infisical-postgres.sql.gz"
  pct exec 110 -- tar -czf - -C /opt/infisical docker-compose.yml .env > "$STAGING/infisical/infisical-compose.tar.gz"
fi

if ct_running 120; then
  echo "[backup] CT 120 Vaultwarden (Zone 2 P0: online SQLite hot backup + attachments/keys)"
  sqlite_hot_backup 120 /opt/vaultwarden/vw-data/db.sqlite3 "$STAGING/vaultwarden/db.sqlite3"
  pct exec 120 -- tar -czf - --exclude='vw-data/db.sqlite3*' -C /opt/vaultwarden vw-data docker-compose.yml > "$STAGING/vaultwarden/vw-files.tar.gz"
fi

if ct_running 121; then
  echo "[backup] CT 121 Immich (Zone 2 P0: PostgreSQL dump + compose/env; originals pulled via Track 2)"
  pct exec 121 -- docker exec immich_postgres pg_dumpall --clean --if-exists --username=postgres | gzip -c > "$STAGING/immich/immich-postgres.sql.gz"
  pct exec 121 -- tar -czf - -C /opt/immich docker-compose.yml .env > "$STAGING/immich/immich-compose.tar.gz"
fi

if ct_running 130; then
  echo "[backup] CT 130 Pi-hole config"
  pct exec 130 -- tar -czf - -C / etc/pihole etc/dnsmasq.d > "$STAGING/pihole/pihole-config.tar.gz"
fi

if ct_running 131; then
  echo "[backup] CT 131 NPM data"
  pct exec 131 -- tar -czf - -C /opt/npm data letsencrypt docker-compose.yml > "$STAGING/npm/npm-data.tar.gz"
fi

if ct_running 140; then
  echo "[backup] CT 140 Homepage config"
  pct exec 140 -- tar -czf - -C /opt/homepage config docker-compose.yml > "$STAGING/homepage/homepage-config.tar.gz"
fi

if ct_running 141; then
  echo "[backup] CT 141 Uptime Kuma (online SQLite hot backup + data)"
  sqlite_hot_backup 141 /opt/uptime-kuma/data/kuma.db "$STAGING/uptime-kuma/kuma.db"
  pct exec 141 -- tar -czf - --exclude='data/kuma.db*' -C /opt/uptime-kuma data docker-compose.yml > "$STAGING/uptime-kuma/uptime-kuma-files.tar.gz"
fi

echo "[backup] Committing staging directory to encrypted restic repo"
restic -r "$REPO" --password-file "$PASS_FILE" backup "$STAGING" --tag homelab-daily

echo "[backup] Pruning old restic snapshots (daily={{ backup_keep_daily }}, weekly={{ backup_keep_weekly }})"
restic -r "$REPO" --password-file "$PASS_FILE" forget \
  --keep-daily "{{ backup_keep_daily }}" \
  --keep-weekly "{{ backup_keep_weekly }}" \
  --prune

rm -rf "${STAGING:?}"/*
echo "[backup] Track 1 backup complete."
