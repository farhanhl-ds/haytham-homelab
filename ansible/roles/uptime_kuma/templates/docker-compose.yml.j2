services:
  uptime-kuma:
    image: {{ uptime_kuma_image }}
    container_name: uptime_kuma
    restart: unless-stopped
    ports:
      - "{{ uptime_kuma_port }}:3001"
    dns:
{% for dns_server in uptime_kuma_dns_servers %}
      - {{ dns_server }}
{% endfor %}
    volumes:
      - ./data:/app/data
